# ════════════════════════════════════════════════════════════════════
# AID — 环境变量模板
# 复制为 .env 并根据需要修改：
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── 运行模式 ──
AID_ENV=development           # development | production | test
LOG_LEVEL=info                # debug | info | warning | error

# ── 数据库（使用 SQLite 时不用配） ──
# DATABASE_URL=postgresql://aid:aid_secret@localhost:5432/alpha_id

# ── PostgreSQL（docker-compose 默认值） ──
PGUSER=aid
PGPASSWORD=aid_secret
PGDATABASE=alpha_id
PGPORT=5432

# ── API 服务 ──
API_PORT=8000

# ── 安全（生产环境必须修改） ──
# SECRET_KEY=change-me-to-a-random-string
# JWT_SECRET=change-me-to-another-random-string
