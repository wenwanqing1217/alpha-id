# ════════════════════════════════════════════════════════════════════
# AID — 环境变量模板
# 复制为 .env 并根据需要修改：
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════

# ── 运行模式 ──
AID_ENV=development           # development | production | test
LOG_LEVEL=info                # debug | info | warning | error

# ── LLM 配置 ──
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.longcat.chat/openai
LLM_MODEL=LongCat-2.0

# ── 安全（生产环境必须修改） ──
AUTH_MASTER_KEY=change-me-to-a-random-hex-string

# ── 百度地图（可选） ──
BAIDU_MAP_AUTH_TOKEN=your_baidu_map_token

# ── 数据库（使用 SQLite 时不用配） ──
# 统一使用 mw 用户（与 mindflow-map、DS 共享 PostgreSQL 实例）
DATABASE_URL=postgresql://mw:mw_secret@localhost:5432/alpha_id

# ── API 服务 ──
API_PORT=8000
